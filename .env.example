AUTH_JWT_SECRET=replace-with-a-local-secret
PORT=4300
OTP_PROVIDER=development
EXPO_TOKEN=replace-with-your-expo-access-token
MAPBOX_ACCESS_TOKEN=pk.replace-with-your-mapbox-token
EXPO_PUBLIC_TENDEROS_API_URL=http://localhost:4300

# Object storage (Garage, S3-compatible). The tenderos backend validates these
# at startup and refuses to boot without them.
# The values below are the DEV-ONLY fixture that `scripts/garage-bootstrap.sh`
# imports into the Compose `garage` service. Production needs its own bucket and
# its own generated key.
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_BUCKET=savanhi-dev
GARAGE_ACCESS_KEY_ID=GK1a2b3c4d5e6f708192a3b4c5
GARAGE_SECRET_ACCESS_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
# Optional. Set only when a CDN or proxy serves the bucket publicly.
# GARAGE_PUBLIC_BASE_URL=https://cdn.example.com/savanhi
# GARAGE_UPLOAD_URL_TTL_SECONDS=900
# GARAGE_READ_URL_TTL_SECONDS=3600
