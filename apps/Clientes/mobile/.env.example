# Public, non-secret API address for Savanhi Clientes. Copy to `.env` only if
# you need to override the default.
#
# In development the app derives the backend host from the Expo dev server, so
# a physical phone reaches your PC over the LAN without this variable. Set it
# to a LAN address (never `localhost`, which on a phone is the phone itself):
# EXPO_PUBLIC_CLIENTES_API_URL=http://192.168.1.10:4300
#
# Release builds REQUIRE this variable and it must use HTTPS:
# EXPO_PUBLIC_CLIENTES_API_URL=https://api.example.com

# Public Mapbox access token (a `pk.` token, never a secret `sk.` one) for the
# Mapa tiles. Put it in this package's `.env` or export it in the shell; the
# repository root `.env` is NOT read by the Expo apps. Needs a new Android
# development-client build; Expo Go cannot run the native map.
# MAPBOX_ACCESS_TOKEN=pk.replace-with-your-public-token
